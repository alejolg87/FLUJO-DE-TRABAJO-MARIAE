rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return userId == request.auth.uid || userId == request.resource.data.userId; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /test/connection {
      allow read: if true;
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.uid != null &&
             data.displayName is string &&
             data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt']) &&
             data.keys().size() <= 10;
    }

    function isValidProject(data) {
      return data.workspaceId is string &&
             data.name is string && data.name.size() > 0 &&
             data.status == 'active' &&
             data.keys().hasAll(['workspaceId', 'name', 'description', 'color', 'status', 'createdAt']) &&
             data.keys().size() == 6;
    }

    function isValidTask(data) {
      return data.projectId is string &&
             data.workspaceId is string &&
             data.title is string && data.title.size() > 0 &&
             data.status in ['todo', 'in-progress', 'in-review', 'done'] &&
             data.priority in ['low', 'medium', 'high'] &&
             data.keys().hasAll(['projectId', 'workspaceId', 'title', 'description', 'status', 'priority', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 15;
    }

    function isValidMessage(data) {
      return data.channelId is string &&
             data.senderId != null &&
             data.content is string &&
             data.keys().hasAll(['channelId', 'senderId', 'senderName', 'content', 'createdAt']) &&
             data.keys().size() <= 10;
    }

    function isValidMember(data) {
      return data.name is string && data.name.size() > 0 &&
             data.role in ['admin', 'member', 'guest'] &&
             data.status in ['active', 'invited'] &&
             data.keys().hasAll(['name', 'role', 'status', 'createdAt']) &&
             data.keys().size() <= 10;
    }

    function isValidChannel(data) {
      return data.workspaceId is string &&
             data.name is string && data.name.size() > 0 &&
             data.type in ['public', 'private', 'dm'] &&
             data.keys().hasAll(['workspaceId', 'name', 'type', 'createdAt']) &&
             data.keys().size() <= 6;
    }

    function isValidNotification(data) {
      return data.userId is string &&
             data.title is string && data.title.size() > 0 &&
             data.read is bool &&
             data.keys().hasAll(['userId', 'title', 'message', 'read', 'createdAt']) &&
             data.keys().size() <= 10;
    }

    function isValidWorkspace(data) {
      return data.name is string && data.name.size() > 0 &&
             data.ownerId != null &&
             data.keys().hasAll(['name', 'ownerId', 'createdAt']) &&
             data.keys().size() == 3;
    }

    function isWorkspaceOwner(workspaceId) {
      // In this new open mode, we check if the ownerId matches or if it's the public workspace
      let ws = get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
      return workspaceId == 'public-workspace' || ws.ownerId == request.auth.uid || ws.ownerId == 'public';
    }

    // --- Collection Matches ---

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /workspaces/{workspaceId} {
      allow read: if true;
      allow create: if isValidWorkspace(incoming());
      allow update: if true;

      match /members/{memberId} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isValidProject(incoming());
      allow update: if true;
      allow delete: if true;
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isValidTask(incoming());
      allow update: if true;
      allow delete: if true;
    }

    match /channels/{channelId} {
      allow read: if true;
      allow create: if isValidChannel(incoming());
    }

    match /messages/{messageId} {
       allow read: if true;
       allow create: if isValidMessage(incoming());
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isValidNotification(incoming());
      allow update: if true;
      allow delete: if true;
    }

  }
}
